<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="20dp">
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnBack" style="@style/Widget.FitTracker.SecondaryButton" android:layout_width="wrap_content" android:layout_height="48dp" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="@string/history_back" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
    <TextView android:id="@+id/txtHistoryKicker" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="@string/history_kicker" android:textColor="@color/purple" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08" app:layout_constraintTop_toBottomOf="@id/btnBack" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <TextView android:id="@+id/txtHistoryTitle" style="@style/Widget.FitTracker.Title" android:layout_width="0dp" android:layout_marginTop="6dp" android:text="@string/history_title" app:layout_constraintTop_toBottomOf="@id/txtHistoryKicker" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <TextView android:id="@+id/txtSessionCount" android:layout_width="0dp" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="14sp" android:background="@drawable/bg_goal" android:padding="14dp" android:layout_marginTop="14dp" app:layout_constraintTop_toBottomOf="@id/txtHistoryTitle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerSessions" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginTop="16dp" android:clipToPadding="false" android:paddingBottom="8dp" app:layout_constraintTop_toBottomOf="@id/txtSessionCount" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <TextView android:id="@+id/txtEmptyHistory" android:layout_width="0dp" android:layout_height="0dp" android:padding="20dp" android:text="@string/empty_history" android:textColor="@color/text_secondary" android:gravity="center" android:textSize="17sp" android:lineSpacingExtra="6dp" app:layout_constraintTop_toBottomOf="@id/txtSessionCount" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
