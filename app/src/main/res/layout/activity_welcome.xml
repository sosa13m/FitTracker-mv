<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_welcome">
    <ScrollView android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="24dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/welcome_badge" android:textColor="@color/purple_dark" android:textStyle="bold" android:textSize="11sp" android:letterSpacing="0.08" android:gravity="center" android:background="@drawable/bg_badge" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="10dp"/>
            <ImageView android:id="@+id/imgLogo" android:layout_width="176dp" android:layout_height="176dp" android:layout_marginTop="24dp" android:src="@drawable/ic_fittracker" android:contentDescription="@string/logo_description"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="@color/lime" android:gravity="center" android:textSize="17sp" android:textStyle="bold" android:letterSpacing="0.06" android:layout_marginTop="16dp"/>
            <TextView android:id="@+id/txtWelcome" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/welcome_title" android:textColor="@color/surface" android:gravity="center" android:textSize="42sp" android:textStyle="bold" android:layout_marginTop="12dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/welcome_message" android:textColor="@color/welcome_muted" android:gravity="center" android:textSize="16sp" android:lineSpacingExtra="5dp" android:layout_marginTop="16dp"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnStart" style="@style/Widget.FitTracker.PrimaryButton" android:layout_marginTop="28dp" android:text="@string/start"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/welcome_footer" android:textColor="@color/welcome_muted" android:gravity="center" android:textSize="12sp" android:layout_marginTop="18dp"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
